# Example run interface for the private validation harness.
# Copy to a LOCAL .env (git-ignored) and point at an EXTERNAL, git-ignored path.
# Never put real private paths or data into the repository.

# Absolute path to the private test set (confidential external validation evidence).
NODITECH_PRIVATE_VALIDATION_FILE=/absolute/private/path/cases.json

# Absolute path for LOCAL detailed reports (value-bearing; must stay off GitHub).
NODITECH_PRIVATE_REPORT_DIR=/absolute/private/path/reports

# Set to 1 to enable local detailed reporting. Default 0 (PASS/FAIL only).
NODITECH_ENABLE_PRIVATE_REPORT=0

# Optional: path to the calculation-engine evaluator module (wired in a later PR).
# NODITECH_EVALUATOR_MODULE=/absolute/path/to/evaluator.js
